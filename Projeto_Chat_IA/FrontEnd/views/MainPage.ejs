<!DOCTYPE html>
 <html lang="pt">
   <head>
     <meta charset="utf-8">
     <meta name="viewport" content="width=device-width, initial-scale=1">
     <title>Main Page</title>
     <link rel="stylesheet" href="/css/Biblioteca.css">
     <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
   </head>
   <body>
     <div class="container-fluid">
         <div class="row">
 
           <div class="divisao-menor" id="esquerda">
               <div class="header-seccao">Social Activities</div>
 
               <div class="separacao-ecra"></div>
 
               <h4>Activity Summary</h4>
 
               <div class="box-container">
                 <div class="box" style="font-size: 1.2em;">⏳<br>Hours in total: </div>
                 <div class="box" style="font-size: 1.2em;">📅<br>Days accessed:</div>
                 <div class="box" style="font-size: 1.2em;">🔥<br>Day streak: </div>
               </div>
 
               <div class="separacao-ecra"></div>
 
               <h4>Friends</h4>
 
               <div class="box-container">
                 <div class="box-clicavel">🔍 Search</div>
                 <div class="box-clicavel" id="addFriend">➕ Add friend</div>
               </div>
               
               <meta name="user-id" content="<%= user._id %>">

               <% if (user.amigos.length !== 0){ %>
                <div class="box"> click to chat with your friends</div>
                <div class="lista-amigos">
                  <% amigos.forEach(function(amigo){%>
                    <div class="amigos" name="<%= amigo._id %>">👤 <%= amigo.username%></div>
                  <% }); %>
                </div>
               <% } 
               else 
               { %>  
                <div class="box" style="color : #0077b6; margin-top: 3%;">
                  <p>You don't have any friends right now...</p>
                  <p>Meanwhile, watch this</p>
                  <iframe
                      src="https://www.youtube.com/embed/b3rNUhDqciM"
                      style="border-radius: 12px; width: 100%; height: 50vh;">
                  </iframe>
              </div>
              
               <% } %>

               <div class="amigos-chat">
                <div class="header-wrapper">
                  <div class="box_chat_header">
                    <div class="chat-header">Chat com ➡️<span id="amigoNome"></span></div>
                  </div>
                  <div class="invite-wrapper">
                    <button class="box-invite" id="invite-button">
                        <img src="/images/botao_party.png" alt="Party">
                    </button>
                    <!-- Tooltip que aparece quando passar o mouse no botão -->
                    <div class="tooltip-party" id="tooltip">Convidar para o servidor</div>
                  </div>
                </div>
              
                <div class="chat-body"></div>
              
                <!-- Painel de Emojis -->
                
          
                <div class="chat-footer">
                  <p><input type="text" id="chatMensagem" placeholder="Mensagens aqui..."></p>
                </div>
              </div>
           </div>
 
           <div class="divisao-maior" id="meio" >
            
              <div class="box-container"> 
                  <button class="box-opcoes" id="opcoes">
                      <img src="/images/options.png">
                  </button>
                  <button class="box-opcoes" id="perfil">
                      <img src="/images/user.png">
                  </button>
              </div>
               <div style="display: flex; justify-content: center;">
                 <h3 id = "Titulo" class="logo-paginaPrincipal">🧠 neuroStorming</h3>
               </div>
 
                 <div class="box-ideias">
 
                   <div class="box-container">
                     <div class="main-box" data-time="10:00" style="cursor: pointer;">Short</div>
                     <div class="main-box" data-time="15:00" style="cursor: pointer;">Medium</div>
                     <div class="main-box" data-time="20:00" style="cursor: pointer;">Long</div>  
                   </div>
 
                   <div class="timer" id="time-display">10.00</div>
                   
                   <form action="/MainPage" method="POST" style="display: contents">

                    <div>
                      <input id="chatTema" placeholder="Chosee your topic..." type="text">
                    </div>
                    
                    <div class="textarea-container">
                      <textarea id="chatContainer" placeholder="Write something..."></textarea>
                    </div>
                   </form>
 
                 </div>
             </div>
 
           <div class="divisao-menor" id="direita">
               <div class="header-seccao">History</div>
               Lorem ipsum dolor sit amet consectetur adipisicing elit. Sapiente incidunt nesciunt libero expedita, dignissimos perspiciatis in error, possimus adipisci, eum officia tenetur! Repellat, aliquid. Repellendus voluptatem maxime illo tempora rerum?
           </div>
 
         </div>
     </div>
     <script src="/socket.io/socket.io.js"></script>
     <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
     <script src="/js/mainPageScript.js"></script>
   </body>