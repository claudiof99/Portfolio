@model UmaFestHub.Web.ViewModels.CartViewModel?
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["Cart_PageTitle"].Value;
	var errorMessage = TempData["ErrorMessage"] as string;
	var returnUrl = ViewBag.ReturnUrl as string;
}

<section class="container hub-section hub-reveal mt-4">
	<div class="hub-section-header"><h2>@Localizer["Cart_Heading"]</h2></div>

	@if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="alert alert-danger d-flex align-items-center gap-2 mb-4" role="alert">
			<i class="bi bi-exclamation-triangle-fill"></i>
			<div>@errorMessage</div>
		</div>
	}

	@if (Model is null || Model.Items.Count == 0)
	{
		<div class="hub-empty-state">@Localizer["Cart_Empty"]</div>
	}
	else
	{
		<div class="d-flex flex-column gap-2 mb-3">
			@for (var i = 0; i < Model.Items.Count; i++)
			{
				var item = Model.Items[i];
				var subtotal = item.Price * item.Quantity;

				<div class="hub-festival-card d-flex align-items-center justify-content-between flex-wrap gap-2">
					<div>
						<p class="mb-0"><strong>@item.ProductType</strong></p>
						<small>@Localizer["Cart_QuantityPrice", item.Quantity, item.Price.ToString("C")]</small>
					</div>
					<div class="d-flex align-items-center gap-3">
						<strong>@subtotal.ToString("C")</strong>
						<form action="/cart/remove" method="post" class="d-inline">
							@Html.AntiForgeryToken()
							<input type="hidden" name="productId" value="@item.ProductId" />
							@if (!string.IsNullOrWhiteSpace(returnUrl))
							{
								<input type="hidden" name="returnUrl" value="@returnUrl" />
							}
							<button type="submit" class="btn btn-danger btn-sm">
								<i class="bi bi-trash"></i> @Localizer["Cart_Remove"]
							</button>
						</form>
					</div>
				</div>
			}
		</div>

		<p><strong>@Localizer["Cart_Total"]</strong> @Model.TotalAmount.ToString("C")</p>
		<form id="checkout-form" action="/checkout" method="post" class="mt-3">
			@Html.AntiForgeryToken()
			@if (!string.IsNullOrWhiteSpace(returnUrl))
			{
				<input type="hidden" name="returnUrl" value="@returnUrl" />
			}
			<button type="submit" class="hub-auth-btn">@Localizer["Cart_Checkout"]</button>
		</form>
	}
</section>

@section Scripts {
	<script>
		document.getElementById('checkout-form')?.addEventListener('submit', function () {
			document.body.classList.add('hub-checkout-pending');
		});
	</script>
}