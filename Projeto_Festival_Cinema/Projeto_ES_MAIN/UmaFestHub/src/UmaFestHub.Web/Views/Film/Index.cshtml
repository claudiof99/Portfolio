@model IReadOnlyList<UmaFestHub.Web.ViewModels.FilmViewModel>
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["FilmIndex_PageTitle"].Value;
	var fromTmdb = (bool?)ViewBag.FromTmdb == true;
}


<section class="container hub-section hub-reveal mt-4">
	<div class="hub-section-header mb-3">
		<h2>@(fromTmdb ? Localizer["FilmIndex_TmdbHeading"] : Localizer["FilmIndex_Heading"])</h2>
	</div>
	<div class="row align-items-center mb-3 g-2 hub-reveal">
		<div class="col-lg-10 col-md-9">
			<form method="get" asp-route="FilmIndex" class="row g-2">
				<div class="col-md-4">
					<input class="form-control" type="search" name="title" value="@ViewBag.FilterTitle" placeholder="@Localizer["Nav_SearchPlaceholder"]" />
				</div>
				<div class="col-md-3">
					<input class="form-control" type="text" name="genre" value="@ViewBag.FilterGenre" placeholder="@Localizer["Common_Genre"]" />
				</div>
				<div class="col-md-2">
					<input class="form-control" type="number" min="1" name="minDurationMinutes" value="@ViewBag.FilterMinDurationMinutes" placeholder="@Localizer["FilmIndex_MinDurationPlaceholder"]" />
				</div>
				<div class="col-md-2">
					<input class="form-control" type="number" min="1" name="maxDurationMinutes" value="@ViewBag.FilterMaxDurationMinutes" placeholder="@Localizer["FilmIndex_MaxDurationPlaceholder"]" />
				</div>
				<div class="col-md-1 d-grid">
					<button class="btn btn-primary" type="submit">@Localizer["Common_Go"]</button>
				</div>
			</form>
		</div>
		<div class="col-lg-2 col-md-3 d-flex justify-content-end">
			<a class="hub-auth-btn" asp-route="FestivalIndex">@Localizer["FilmIndex_BrowseFestivals"]</a>
		</div>
	</div>

	@if (Model is null || Model.Count == 0)
	{
		<div class="hub-empty-state">@Localizer["FilmIndex_NoMoviesFound"]</div>
	}
	else
	{
		<div class="hub-festival-grid hub-reveal-stagger">
			@foreach (var film in Model)
			{
				<article class="hub-festival-card hub-reveal" data-tilt style="position:relative;">
					<div class="hub-thumb">
						@if (!string.IsNullOrWhiteSpace(film.ImageUrl))
						{
							<img src="@film.ImageUrl" alt="@film.Name" style="width: 100%; height: 100%; object-fit: cover; border-radius: 8px;" />
						}
						else
						{
							<span>@(string.IsNullOrWhiteSpace(film.Name) ? "?" : film.Name.Substring(0, 1).ToUpperInvariant())</span>
						}
						<div class="hub-card-overlay"><span>@Localizer["Common_Details"]</span></div>
					</div>
					<strong>@film.Name</strong>
					<small>@(film.Genres.Count == 0 ? Localizer["FilmIndex_Uncategorized"] : string.Join(", ", film.Genres))</small>
					<small>@(string.IsNullOrWhiteSpace(film.Description) ? Localizer["FilmIndex_NoDescription"] : (Localizer.LocalizeFilmDescription(film.Id, film.Description).Length > 120 ? Localizer.LocalizeFilmDescription(film.Id, film.Description)[..120] + "..." : Localizer.LocalizeFilmDescription(film.Id, film.Description)))</small>
					<small>@Localizer["FilmIndex_DurationLabel", film.DurationMinutes]</small>
					<div class="mt-3 pt-2 w-100 d-flex justify-content-center">
						@if (film.Id != Guid.Empty)
						{
							<a class="hub-auth-btn w-100 text-center justify-content-center" href="/films/@film.Id">@Localizer["Common_Details"]</a>
						}
						else if (!string.IsNullOrWhiteSpace(film.Url))
						{
							<a class="hub-auth-btn w-100 text-center justify-content-center" href="@film.Url" target="_blank" rel="noopener noreferrer">@Localizer["FilmIndex_OpenTmdb"]</a>
						}
					</div>
				</article>
			}
		</div>
	}
</section>
