@using UmaFestHub.Domain.Entities
@using UmaFestHub.Web.ViewModels
@model UmaFestHub.Web.ViewModels.HomePageViewModel
@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["Home_PageTitle"].Value;
	ViewData["Title"] = Localizer["Home_PageTitle"].Value;
	var isAdmin = User.IsInRole("Admin");
	var isManager = User.IsInRole("Organizer");
}

<div class="hub-home container">
	@if (Model.FeaturedFestivals.Any())
	{
		<div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="6000">
			<div class="carousel-inner">
				@foreach (var (feat, index) in Model.FeaturedFestivals.Select((f, i) => (f, i)))
				{
					<div class="carousel-item @(index == 0 ? "active" : "")">
						<section class="hub-hero" style="position: relative; border-radius: 20px; overflow: hidden;">
							<div class="hub-hero-overlay"></div>
							<div class="hub-hero-particles" aria-hidden="true">
								<div class="hub-hero-particle"></div>
								<div class="hub-hero-particle"></div>
								<div class="hub-hero-particle"></div>
								<div class="hub-hero-particle"></div>
								<div class="hub-hero-particle"></div>
								<div class="hub-hero-particle"></div>
							</div>
							<div class="hub-hero-content">
								<p class="hub-hero-kicker">@Localizer["Home_NextFestival"]</p>
								<h1>@feat.Name</h1>
								<p>@feat.StartDateUtc.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture) @Localizer["Common_To"] @feat.EndDateUtc.ToString("dd MMM yyyy", CultureInfo.CurrentUICulture)</p>

								<div data-countdown-target="@feat.StartDateUtc.ToString("o")"
								     data-countdown-end="@feat.EndDateUtc.ToString("o")"
								     data-countdown-prefix="@Localizer["Countdown_GoingLiveIn"]"
								     data-countdown-live="@Localizer["Countdown_LiveNow"]"
								     data-countdown-ended="@Localizer["Countdown_FestivalEnded"]"
								     data-countdown-days="@Localizer["Countdown_Days"]"
								     data-countdown-hours="@Localizer["Countdown_Hours"]"
								     data-countdown-mins="@Localizer["Countdown_Mins"]"
								     data-countdown-secs="@Localizer["Countdown_Secs"]"></div>

								<a class="hub-cta" asp-route="FestivalDetails" asp-route-id="@feat.Id">@Localizer["Home_BrowseFestival"]</a>
							</div>
						</section>
					</div>
				}
			</div>

			@if (Model.FeaturedFestivals.Count > 1)
			{
				<button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" style="width: 5%; justify-content: flex-start; padding-left: 15px;">
					<span class="carousel-control-prev-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Previous</span>
				</button>
				<button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next" style="width: 5%; justify-content: flex-end; padding-right: 15px;">
					<span class="carousel-control-next-icon" aria-hidden="true"></span>
					<span class="visually-hidden">Next</span>
				</button>
			}
		</div>
	}
	else
	{
		<div class="hub-empty-state mt-4">@Localizer["Common_ComingSoon"]</div>
	}

	@if (Model.IsAuthenticated)
	{
		<text>
		@* Signed-in carousels: watchlist + favorites + Seen (Watched) + Recommendations. *@

		<section class="hub-section hub-reveal" id="recommended-for-you">
			<div class="hub-section-header">
				<h2>@Localizer["Home_RecommendedForYou"]</h2>
			</div>
			@if (Model.RecommendedFilms.Count == 0)
			{
				<div class="hub-empty-state">@Localizer["Home_EmptyRecommendations"]</div>
			}
			else
			{
				var rowId = "recommended-row";
				var showArrows = Model.RecommendedFilms.Count > 9;
				var viewportStyle = showArrows
					? "padding: 0 28px; min-height: 268px; display:flex; align-items:center;"
					: "padding: 0 12px; min-height: 268px; display:flex; align-items:center;";
				<div class="hub-empty-state py-1 px-3 position-relative" style="border-radius: 12px; overflow: hidden; min-height: 280px;">
					@if (showArrows)
					{
						<button type="button"
							class="btn btn-outline-light rounded-circle position-absolute top-50 start-0 translate-middle-y"
							style="z-index: 2; width: 34px; height: 34px; margin-left: 3px; padding: 0; font-size: 22px; line-height: 1;"
							aria-label="@Localizer["Home_ScrollRecommendationsLeft"]"
							onclick="hubScrollFavorites('@rowId', -420);">
							←
						</button>
					}

					<div id="@rowId" class="hub-favorites-viewport" style="@viewportStyle">
						<div id="@($"{rowId}-track")"
							 class="hub-favorites-track"
							 style="display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:6px;">
							@foreach (var rec in Model.RecommendedFilms)
							{
								<div class="hub-festival-card" data-tilt
									 style="position:relative; background: #111; width:120px; height:245px; display:flex; flex-direction:column; flex:0 0 120px; padding:2px; border-radius:12px;">
									<a href="/films/@rec.FilmId" style="display:block; text-decoration:none; color:inherit;">
										<div class="hub-thumb"
											 style="background: #111; border-radius: 10px; overflow: hidden; margin: 0; width: 100%; height: 180px;">
											@if (!string.IsNullOrWhiteSpace(rec.PosterUrl))
											{
												<img src="@rec.PosterUrl"
													 alt="@rec.Title"
													 style="width:100%; height:100%; object-fit:cover; display:block;" />
											}
											else
											{
												var cardInitial = string.IsNullOrWhiteSpace(rec.Title) ? "?" : rec.Title.Substring(0, 1).ToUpperInvariant();
												<span>@cardInitial</span>
											}
										</div>
									</a>

									<div style="margin-top: 6px; padding: 0 2px; display:flex; align-items:flex-start; justify-content:space-between; gap:6px;">
										<div style="font-size: 0.85rem; line-height: 1.15; color: #eaeaea; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-width: 0;">
											<strong>@rec.Title</strong>
										</div>
									</div>
								</div>
							}
						</div>
					</div>

					@if (showArrows)
					{
						<button type="button"
							class="btn btn-outline-light rounded-circle position-absolute top-50 end-0 translate-middle-y"
							style="z-index: 2; width: 34px; height: 34px; margin-right: 3px; padding: 0; font-size: 22px; line-height: 1;"
							aria-label="@Localizer["Home_ScrollRecommendationsRight"]"
							onclick="hubScrollFavorites('@rowId', 420);">
							→
						</button>
					}
				</div>
			}
		</section>

		@await Html.PartialAsync("_PersonalListCarousel", new PersonalListCarouselViewModel
		{
			SectionId = "my-watchlist",
			SectionTitle = Localizer["Home_MyWatchlist"].Value,
			SectionTitleHref = Url.Action("Index", "PersonalList", new { type = PersonalListType.Watchlist }) ?? "/PersonalList?type=Watchlist",
			RowElementId = "watchlist-row",
			ListType = PersonalListType.Watchlist,
			Films = Model.WatchlistFilms,
			EmptyMessage = Localizer["Home_EmptyWatchlist"].Value,
			RemoveTooltip = Localizer["PersonalList_TabWatchlist"].Value,
			RemoveAriaLabel = Localizer["PersonalList_TabWatchlist"].Value,
			ScrollLeftAriaLabel = Localizer["Home_ScrollWatchlistLeft"].Value,
			ScrollRightAriaLabel = Localizer["Home_ScrollWatchlistRight"].Value,
			RemoveButtonGlyph = "-",
			RemoveReturnUrl = Model.FeaturedFestivals.Any()
				? $"{Url.Action("Index", "Home") ?? "/"}#browse-festival"
				: null
		})

		@await Html.PartialAsync("_PersonalListCarousel", new PersonalListCarouselViewModel
		{
			SectionId = "my-favorites",
			SectionTitle = Localizer["Home_MyFavorites"].Value,
			SectionTitleHref = Url.Action("Index", "PersonalList", new { type = PersonalListType.Favorites }) ?? "/PersonalList?type=Favorites",
			RowElementId = "favorites-row",
			ListType = PersonalListType.Favorites,
			Films = Model.FavoriteFilms,
			EmptyMessage = Localizer["Home_EmptyFavorites"].Value,
			RemoveTooltip = Localizer["PersonalList_TabFavorites"].Value,
			RemoveAriaLabel = Localizer["PersonalList_TabFavorites"].Value,
			ScrollLeftAriaLabel = Localizer["Home_ScrollFavoritesLeft"].Value,
			ScrollRightAriaLabel = Localizer["Home_ScrollFavoritesRight"].Value,
			RemoveButtonGlyph = "★"
		})

		@* Seen carousel: Model.WatchedFilms from PersonalListType.Watched; “See all” → /personal-list?type=Watched (full hub with tabs). /watchHistory is the same Seen data without tabs (nav menu). *@
		@await Html.PartialAsync("_PersonalListCarousel", new PersonalListCarouselViewModel
		{
			SectionId = "my-seen",
			SectionTitle = Localizer["Home_Seen"].Value,
			SectionTitleHref = Url.Action("Index", "PersonalList", new { type = PersonalListType.Watched }) ?? "/PersonalList?type=Watched",
			RowElementId = "seen-row",
			ListType = PersonalListType.Watched,
			Films = Model.WatchedFilms,
			EmptyMessage = Localizer["Home_EmptySeen"].Value,
			RemoveTooltip = Localizer["PersonalList_TabSeen"].Value,
			RemoveAriaLabel = Localizer["PersonalList_TabSeen"].Value,
			ScrollLeftAriaLabel = Localizer["Home_ScrollSeenLeft"].Value,
			ScrollRightAriaLabel = Localizer["Home_ScrollSeenRight"].Value,
			RemoveButtonGlyph = "✓",
			RemoveReturnUrl = Model.FeaturedFestivals.Any()
				? $"{Url.Action("Index", "Home") ?? "/"}#my-seen"
				: null
		})

		@if (Model.WatchlistFilms.Count > 0 || Model.FavoriteFilms.Count > 0 || Model.WatchedFilms.Count > 0)
		{
			@* Horizontal scroll helper for any non-empty personal list strip (includes Seen). *@
			<script src="~/js/personalListCarouselHomePage.js"></script>
		}
		</text>
	}
</div>
