@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["Login_PageTitle"].Value;
}

<div class="hub-auth-wrap">
	<div class="hub-auth-card">
		<div class="hub-auth-brand">
			<div class="hub-brand-mark">UF</div>
			<div>UmaFestHub</div>
		</div>

		<h2>@Localizer["Login_Heading"]</h2>
		<p class="hub-auth-subtitle">@Localizer["Login_Subtitle"]</p>

		@if (!ViewData.ModelState.IsValid)
		{
			<div class="alert alert-danger">
				@foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
				{
					<div>@error.ErrorMessage</div>
				}
			</div>
		}

		<form method="post" action="/login" class="hub-auth-form">
			@Html.AntiForgeryToken()
			<div>
				<label>@Localizer["Common_Email"]</label>
				<input name="Email" type="email" placeholder="@Localizer["Common_EmailPlaceholder"]" required />
			</div>

			<div>
				<div class="d-flex justify-content-between align-items-center mb-2">
					<label class="mb-0">@Localizer["Common_Password"]</label>
					<a class="hub-muted-link fw-bold" asp-route="ForgotPassword">@Localizer["Login_ForgotPassword"]</a>
				</div>
				<input name="Password" type="password" placeholder="@Localizer["Common_PasswordPlaceholder"]" required />
			</div>
			

			<button type="submit" class="hub-auth-btn">@Localizer["Login_Submit"]</button>
		</form>

		<p class="hub-auth-meta">
			@Localizer["Login_NoAccount"]
			<a class="fw-bold" href="/register">@Localizer["Login_CreateOne"]</a>
		</p>
	</div>
</div>
