@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["ForgotPassword_PageTitle"].Value;
}

<section class="auth-page">
	<div class="auth-card">
		<div class="mb-2">
			<a href="/login" class="text-decoration-none" style="color:var(--text-secondary);">
				<i class="bi bi-arrow-left"></i>
			</a>
		</div>

		<div class="text-center">
			<div class="auth-logo">UF</div>
			<div class="mt-2 fw-semibold" style="color:var(--text-primary);">UmaFestHub</div>
		</div>

		<h2 class="text-center mt-4 mb-1" style="color:var(--text-primary);">@Localizer["ForgotPassword_Heading"]</h2>
		<p class="text-center mb-4" style="color:var(--text-secondary);">@Localizer["ForgotPassword_Subtitle"]</p>

		@if (TempData["SuccessMessage"] is string successMessage && !string.IsNullOrWhiteSpace(successMessage))
		{
			<div class="alert alert-success" role="alert">@successMessage</div>
		}

		@if (!ViewData.ModelState.IsValid)
		{
			var hasErrors = false;
			foreach (var state in ViewData.ModelState.Values)
			{
				if (state.Errors.Count > 0)
				{
					hasErrors = true;
					break;
				}
			}

			if (hasErrors)
			{
				<div class="alert alert-danger" role="alert">
					@foreach (var state in ViewData.ModelState.Values)
					{
						foreach (var error in state.Errors)
						{
							<div>@error.ErrorMessage</div>
						}
					}
				</div>
			}
		}

		<form method="post" asp-route="ForgotPasswordPost" class="d-grid" style="gap:1rem;">
			@Html.AntiForgeryToken()
			<div>
				<label for="email" class="form-label" style="font-size:.85rem;font-weight:600;color:var(--text-secondary);">@Localizer["Common_Email"]</label>
				<input id="email" name="Email" type="email" class="auth-input" placeholder="@Localizer["Common_EmailPlaceholder"]" required />
			</div>

			<button type="submit" class="auth-btn">@Localizer["ForgotPassword_Submit"]</button>
		</form>
	</div>
</section>
