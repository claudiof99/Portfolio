@model UmaFestHub.Web.ViewModels.SessionViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Localizer["Session_PageTitle"].Value;
    var festivalFilmId = ViewBag.FestivalFilmId as Guid?;
}

<section class="page-hero">
    <div class="container">
        <h1>@Localizer["Session_PageTitle"]</h1>
        <p>@Localizer["Session_Subtitle"]</p>
    </div>
</section>

<section class="container info-panel">
    @if (User.IsInRole("Organizer") || User.IsInRole("Admin"))
    {
        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h5 text-white">@Localizer["Session_CreateHeading"]</h2>
                <form method="post" action="/sessions/create" class="row g-2">
                    @Html.AntiForgeryToken()


                    <input type="hidden" name="FestivalFilmId" value="@festivalFilmId" />
                    <input type="hidden" name="FestivalId" value="@ViewBag.FestivalId" />



                    <div class="col-md-3">
                        <label class="form-label text-white">@Localizer["Session_TypeLabel"]</label>
                        <select name="SessionType" class="form-select" required>
                            <option value="">@Localizer["Session_SelectType"]</option>
                            <option value="FixedSession">@Localizer["Session_TypeFixed"]</option>
                            <option value="PremierSession">@Localizer["Session_TypePremier"]</option>
                            <option value="AccessWindowSession">@Localizer["Session_TypeAccessWindow"]</option>
                        </select>
                    </div>

                    <div id="startEndFields" class="row g-2">
                        <div class="col-md-3">
                            <label class="form-label text-white">@Localizer["Session_StartUtc"]</label>
                            <input type="datetime-local" name="StartTimeUtc" class="form-control" required />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label text-white">@Localizer["Session_EndUtc"]</label>
                            <input type="datetime-local" name="EndTimeUtc" class="form-control" required />
                        </div>
                    </div>

                    <div class="col-md-3" id="priceField">
                        <label class="form-label text-white">@Localizer["Rental_PriceLabel"]</label>
                        <input type="number" name="Price" class="form-control" step="0.01" min="0" value="10.00" />
                    </div>

                    <div id="accessWindowFields" class="row g-2" style="display:none;">
                        <div class="col-md-3">
                            <label class="form-label text-white">@Localizer["Session_AccessStartUtc"]</label>
                            <input type="datetime-local" name="StartTimeUtc" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-white">@Localizer["Session_AccessEndUtc"]</label>
                            <input type="datetime-local" name="EndTimeUtc" class="form-control" />
                        </div>
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">@Localizer["Session_CreateSubmit"]</button>
                    </div>
                </form>

                <script>
                    document.addEventListener('DOMContentLoaded', function() {
                        const sessionTypeSelect = document.querySelector('select[name="SessionType"]');
                        if (!sessionTypeSelect) return;

                       function updateFieldVisibility() {
                       const isAccessWindow = sessionTypeSelect.value === 'AccessWindowSession';
                       const startEndFields = document.getElementById('startEndFields');
                       const accessWindowFields = document.getElementById('accessWindowFields');
                       const priceField = document.getElementById('priceField');

                       startEndFields.style.display = isAccessWindow ? 'none' : '';
                       accessWindowFields.style.display = isAccessWindow ? '' : 'none';
                       if (priceField) priceField.style.display = isAccessWindow ? 'none' : '';

                       // Disable hidden inputs so they don't submit
                       startEndFields.querySelectorAll('input').forEach(i => i.disabled = isAccessWindow);
                       accessWindowFields.querySelectorAll('input').forEach(i => i.disabled = !isAccessWindow);
                       if (priceField) {
                           priceField.querySelectorAll('input').forEach(i => i.disabled = isAccessWindow);
                       }
     } 

                        sessionTypeSelect.addEventListener('change', updateFieldVisibility);
                        updateFieldVisibility();
                    });
                </script>
            </div>
        </div>
    }
</section>