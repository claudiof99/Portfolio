@*
  Horizontal recommendation strip for Home page.
  Scroll via personalListCarouselHomePage.js (hubScrollFavorites).
*@
@using UmaFestHub.Web.ViewModels
@model UmaFestHub.Web.ViewModels.RecommendationCarouselViewModel

<section class="hub-section" id="@Model.SectionId">
	<div class="hub-section-header">
		@if (!string.IsNullOrWhiteSpace(Model.SectionTitleHref))
		{
			<h2><a href="@Model.SectionTitleHref" class="hub-section-title-link">@Model.SectionTitle</a></h2>
		}
		else
		{
			<h2>@Model.SectionTitle</h2>
		}
	</div>
	@if (Model.Recommendations.Count == 0)
	{
		<div class="hub-empty-state">@Model.EmptyMessage</div>
	}
	else
	{
		var rowId = Model.RowElementId;
		var showArrows = Model.Recommendations.Count > 9;
		var viewportStyle = showArrows
			? "padding: 0 28px; min-height: 268px; display:flex; align-items:center;"
			: "padding: 0 12px; min-height: 268px; display:flex; align-items:center;";
		<div class="hub-empty-state py-1 px-3 position-relative" style="border-radius: 12px; overflow: hidden; min-height: 280px;">
			@if (showArrows)
			{
				<button type="button"
				        class="btn btn-outline-light rounded-circle position-absolute top-50 start-0 translate-middle-y"
				        style="z-index: 2; width: 34px; height: 34px; margin-left: 3px; padding: 0; font-size: 22px; line-height: 1;"
				        aria-label="@Model.ScrollLeftAriaLabel"
				        onclick="hubScrollFavorites('@rowId', -420);">
					←
				</button>
			}

			<div id="@rowId" class="hub-favorites-viewport" style="@viewportStyle">
				<div id="@($"{rowId}-track")"
				     class="hub-favorites-track"
				     style="display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:6px;">
					@foreach (var rec in Model.Recommendations)
					{
						<div class="hub-festival-card"
						     style="background: #111; width:120px; height:245px; display:flex; flex-direction:column; flex:0 0 120px; padding:2px; border-radius:12px;">
							<a href="/films/@rec.FilmId" style="display:block; text-decoration:none; color:inherit;">
								<div class="hub-thumb"
								     style="background: #111; border-radius: 10px; overflow: hidden; margin: 0; width: 100%; height: 180px;">
									@if (!string.IsNullOrWhiteSpace(rec.PosterUrl))
									{
										<img src="@rec.PosterUrl"
										     alt="@rec.Title"
										     style="width:100%; height:100%; object-fit:cover; display:block;" />
									}
									else
									{
										var cardInitial = string.IsNullOrWhiteSpace(rec.Title) ? "?" : rec.Title.Substring(0, 1).ToUpperInvariant();
										<span>@cardInitial</span>
									}
								</div>
							</a>

							<div style="margin-top: 6px; padding: 0 2px; display:flex; align-items:flex-start; justify-content:space-between; gap:6px;">
								<div style="font-size: 0.85rem; line-height: 1.15; color: #eaeaea; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-width: 0;">
									<strong>@rec.Title</strong>
								</div>
								<span class="badge bg-danger" style="font-size: 0.65rem; padding: 2px 4px;">@rec.Score.ToString("P0")</span>
							</div>
						</div>
					}
				</div>
			</div>

			@if (showArrows)
			{
				<button type="button"
				        class="btn btn-outline-light rounded-circle position-absolute top-50 end-0 translate-middle-y"
				        style="z-index: 2; width: 34px; height: 34px; margin-right: 3px; padding: 0; font-size: 22px; line-height: 1;"
				        aria-label="@Model.ScrollRightAriaLabel"
				        onclick="hubScrollFavorites('@rowId', 420);">
					→
				</button>
			}
		</div>
	}
</section>