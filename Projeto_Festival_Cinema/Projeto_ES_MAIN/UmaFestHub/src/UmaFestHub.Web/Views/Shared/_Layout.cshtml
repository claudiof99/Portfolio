@* In-app notifications: CSRF for POST /notifications/ack; body data-* flags consumed by signalr-notifications.js. *@
@using System.Globalization
@using System.Linq
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="dark">
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
	var notificationCsrf = User.Identity?.IsAuthenticated == true ? Antiforgery.GetAndStoreTokens(Context).RequestToken : "";
	var showPurchaseCelebration = TempData["ShowPurchaseConfetti"] != null;
}
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@(ViewData["Title"] ?? Localizer["Layout_TitleSuffix"].Value) - @Localizer["Layout_TitleSuffix"]</title>

	<!-- Bootstrap 5 and Bootstrap Icons for consistent UI components/icons -->
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/hub-theme.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/hub-animations.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/hub-enhancements.css" asp-append-version="true" />
</head>
@* In-app notifications: body data-* toggles signalr-notifications.js; CSRF for POST /notifications/ack. *@
<body class="@(showPurchaseCelebration ? "hub-instant-page" : null)" data-signalr-notifications="@(User.Identity?.IsAuthenticated == true ? "true" : "false")" data-notification-csrf="@notificationCsrf">
	@if (showPurchaseCelebration)
	{
		<div data-confetti="true" aria-hidden="true"></div>
	}
	<div id="hub-page-skeleton" class="hub-page-skeleton" aria-hidden="true">
		<div class="hub-page-skeleton-inner">
			<div class="hub-skeleton hub-page-skeleton-hero"></div>
			<div class="hub-skeleton hub-page-skeleton-bar"></div>
			<div class="hub-page-skeleton-row">
				<div class="hub-skeleton hub-page-skeleton-card"></div>
				<div class="hub-skeleton hub-page-skeleton-card"></div>
				<div class="hub-skeleton hub-page-skeleton-card"></div>
				<div class="hub-skeleton hub-page-skeleton-card"></div>
				<div class="hub-skeleton hub-page-skeleton-card"></div>
			</div>
		</div>
	</div>
	<div class="app-shell">
		@await Html.PartialAsync("_NavBar")

		<main role="main" class="app-main">
			@RenderBody()
		</main>

		<footer class="app-footer">
			<div class="container hub-footer-inner">
				<p>@Localizer["Layout_Footer"]</p>
				<p class="hub-footer-collab-label">@Localizer["Layout_FooterCollab"]</p>
				<div class="hub-footer-logos">
					<span class="hub-footer-logo-chip">
						<img src="~/images/sky-portugal-logo.png" alt="Sky Portugal logo" class="hub-footer-logo" />
					</span>
					<span class="hub-footer-logo-chip">
						<img src="~/images/universidade-madeira-logo.png" alt="University of Madeira logo" class="hub-footer-logo" />
					</span>
				</div>
			</div>
		</footer>
	</div>

	<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
		<div id="accessDeniedToast" class="toast text-bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
			<div class="d-flex">
				<div class="toast-body">@Localizer["Layout_AccessDenied"]</div>
				<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="@Localizer["Common_Close"]"></button>
			</div>
		</div>
	</div>

	<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080; margin-bottom: 80px;">
		<div id="validationErrorToast" class="toast text-bg-warning border-0" role="alert" aria-live="assertive" aria-atomic="true" data-error="@(TempData["ErrorMessage"] ?? "")">
			<div class="d-flex">
				<div class="toast-body">@(TempData["ErrorMessage"] ?? "")</div>
				<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="@Localizer["Common_Close"]"></button>
			</div>
		</div>
	</div>

	<div class="modal fade" id="signInRequiredModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content hub-login-modal">
				<div class="modal-header border-0 pb-0">
					<h5 class="modal-title">@Localizer["Modal_SignInRequired_Title"]</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Common_Close"]"></button>
				</div>
				<div class="modal-body pt-2">
					<p class="mb-3">@Localizer["Modal_SignInRequired_Body"]</p>
					<a class="hub-auth-btn d-inline-flex justify-content-center w-100" id="loginModalCta" href="/login">@Localizer["Modal_SignInRequired_Cta"]</a>
				</div>
			</div>
		</div>
	</div>

	<div class="modal fade" id="duplicateCartItemModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content hub-login-modal">
				<div class="modal-header border-0 pb-0">
					<h5 class="modal-title">@Localizer["Modal_DuplicateCart_Title"]</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Common_Close"]"></button>
				</div>
				<div class="modal-body pt-2">
					<p class="mb-3" id="duplicateCartItemMessage">@(TempData["DuplicateCartItemMessage"] ?? Localizer["Modal_DuplicateCart_Message"].Value)</p>
					<div class="d-flex flex-column gap-2">
						<a class="hub-auth-btn d-inline-flex justify-content-center w-100" href="/cart">@Localizer["Modal_DuplicateCart_GoToCart"]</a>
						<button type="button" class="btn btn-outline-light w-100" data-bs-dismiss="modal">@Localizer["Modal_DuplicateCart_ContinueBrowsing"]</button>
					</div>
				</div>
			</div>
		</div>
	</div>

	@* In-app notifications: dismiss-only Bootstrap modal (title/body/OK wired by signalr-notifications.js). *@
	@if (User.Identity?.IsAuthenticated == true)
	{
		<div class="modal fade" id="realtimeNotificationModal" tabindex="-1" aria-hidden="true">
			<div class="modal-dialog modal-dialog-centered">
				<div class="modal-content hub-login-modal">
					<div class="modal-header border-0 pb-0">
						<h5 class="modal-title" id="realtimeNotificationTitle">@Localizer["Modal_Notification_Title"]</h5>
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="@Localizer["Common_Close"]"></button>
					</div>
					<div class="modal-body pt-2">
						<p class="mb-3" id="realtimeNotificationMessage" style="white-space: pre-line;"></p>
						<div class="d-flex flex-column gap-2">
							<button type="button" class="hub-auth-btn w-100" id="realtimeNotificationOkBtn">@Localizer["Modal_Ok"]</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	}

	<script>
		// Show duplicate cart item modal
		const duplicateMessage = document.getElementById("duplicateCartItemMessage");
		if (duplicateMessage && duplicateMessage.textContent.trim()) {
			const modal = document.getElementById("duplicateCartItemModal");
			if (modal && window.bootstrap) {
				bootstrap.Modal.getOrCreateInstance(modal).show();
			}
		}
	</script>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	@* In-app notifications: SignalR client + backlog/real-time modal pipeline. *@
	@if (User.Identity?.IsAuthenticated == true)
	{
		var notificationI18nKeys = new[]
		{
			"Notification_ReviewPendingTitle", "Notification_ReviewPendingMessage",
			"Notification_ReviewApprovedTitle", "Notification_ReviewRejectedTitle",
			"Review_StatusApproved", "Review_StatusRejected",
			"Notification_ReviewOutcomeResponse", "Notification_ReviewOutcomeFestival",
			"Notification_ReviewOutcomeFilm", "Notification_ReviewOutcomeRating", "Notification_ReviewOutcomeYourReview",
			"Notification_ReplyPendingTitle", "Notification_ReplyPendingMessage",
			"Notification_ReplyApprovedTitle", "Notification_ReplyRejectedTitle", "Notification_ReplyOutcomeYourReply",
			"Notification_FestivalEndingTitle", "Notification_FestivalEndingDefaultName", "Notification_FestivalEndingMessage",
			"Notification_EndingVerySoon", "Notification_LessThan1Day", "Notification_LessThanDays",
			"Notification_LessThan1Hour", "Notification_LessThanHours",
			"Notification_RentalExpiringTitle", "Notification_RentalDefaultFilm", "Notification_RentalExpiringMessage",
			"Notification_AwardVotingClosedTitle", "Notification_AwardFinalResults", "Notification_AwardResultLine",
			"Award_UnknownNominee",
			"Notification_PurchaseCompletedTitle", "Notification_PurchaseCompletedMessage",
		};
		var notificationI18n = notificationI18nKeys.ToDictionary(
			k => k,
			k =>
			{
				var localized = Localizer[k];
				return localized.ResourceNotFound ? k : localized.Value;
			});
		<script>
			window.__notificationI18n = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(notificationI18n));
		</script>
		<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
		<script src="~/js/signalr-notifications.js" asp-append-version="true"></script>
	}
	@* Frontend enhancement modules (OCP: self-contained, zero coupling) *@
	<script src="~/js/hub-page-loader.js" asp-append-version="true"></script>
	<script src="~/js/hub-scroll-reveal.js" asp-append-version="true"></script>
	<script src="~/js/hub-countdown.js" asp-append-version="true"></script>
	<script src="~/js/hub-confetti.js" asp-append-version="true"></script>
	<script src="~/js/hub-theme-toggle.js" asp-append-version="true"></script>
	<script src="~/js/hub-tilt.js" asp-append-version="true"></script>
	<script src="~/js/hub-carousel-enhanced.js" asp-append-version="true"></script>
	<script src="~/js/hub-star-rating.js" asp-append-version="true"></script>
	<script>
		document.addEventListener("click", function (event) {
			const link = event.target.closest("a.requires-auth");
			if (!link) {
				return;
			}

			const needsLogin = link.dataset.authenticated === "false";
			if (!needsLogin) {
				return;
			}

			event.preventDefault();
			const loginUrl = link.dataset.loginUrl || "/login";
			const cta = document.getElementById("loginModalCta");
			if (cta) {
				cta.setAttribute("href", loginUrl);
			}

			if (window.bootstrap) {
				const modalElement = document.getElementById("signInRequiredModal");
				if (modalElement) {
					bootstrap.Modal.getOrCreateInstance(modalElement).show();
				}
			}
		});

		const params = new URLSearchParams(window.location.search);
		if (params.get("toast") === "access-denied" && window.bootstrap) {
			const toastElement = document.getElementById("accessDeniedToast");
			if (toastElement) {
				bootstrap.Toast.getOrCreateInstance(toastElement).show();
			}
		}

		// Show validation error toast only if there's actual error content
		const toastElement = document.getElementById("validationErrorToast");
		if (toastElement && toastElement.dataset.error && window.bootstrap) {
			bootstrap.Toast.getOrCreateInstance(toastElement).show();
		}
	</script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
