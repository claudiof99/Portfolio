@{
	Layout = null;
	var festivalId = ViewBag.FestivalId?.ToString() ?? "";
	var festivalFilmId = ViewBag.FestivalFilmId?.ToString() ?? "";
	var sessionId = ViewBag.SessionId?.ToString() ?? "";
	var youtubeVideoId = ViewBag.YoutubeVideoId?.ToString() ?? "";
	var filmName = ViewBag.FilmName?.ToString() ?? "Film";
	var filmDescription = ViewBag.FilmDescription?.ToString() ?? "";
	var posterUrl = ViewBag.PosterUrl?.ToString() ?? "";
	var festivalName = ViewBag.FestivalName?.ToString() ?? "Festival";
	var displayName = ViewBag.DisplayName?.ToString() ?? "Guest";
	var joinCode = ViewBag.JoinCode?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Watch Party — @filmName — UmaFestHub</title>
	<meta name="description" content="Join a live watch party for @filmName at @festivalName on UmaFestHub." />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
		integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
	<style>
		/* ═══════════════════════════════════════════════
		   WATCH PARTY — UmaFestHub Cinema + Chat
		   ═══════════════════════════════════════════════ */
		:root {
			--wp-bg: #06080d;
			--wp-surface: #0d1117;
			--wp-surface-2: #161b22;
			--wp-accent: #e50914;
			--wp-accent-glow: rgba(229, 9, 20, 0.35);
			--wp-text: #f0f6fc;
			--wp-muted: #8b949e;
			--wp-border: rgba(139, 148, 158, 0.15);
			--wp-chat-bg: #0d1117;
			--wp-msg-self: rgba(229, 9, 20, 0.12);
			--wp-msg-other: rgba(255, 255, 255, 0.04);
		}

		*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

		html, body { height: 100%; overflow: hidden; }

		body {
			font-family: 'Inter', system-ui, -apple-system, sans-serif;
			background: var(--wp-bg);
			color: var(--wp-text);
		}

		/* ── Film grain overlay ── */
		body::before {
			content: '';
			position: fixed;
			inset: 0;
			z-index: 9999;
			pointer-events: none;
			opacity: 0.02;
			background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
			background-size: 200px;
		}

		/* ── Main layout ── */
		.wp-shell {
			display: grid;
			grid-template-columns: 1fr 380px;
			grid-template-rows: auto 1fr;
			height: 100vh;
			gap: 0;
		}

		/* ── Top bar ── */
		.wp-top {
			grid-column: 1 / -1;
			padding: 0.75rem 1.5rem;
			background: var(--wp-surface);
			border-bottom: 1px solid var(--wp-border);
			display: flex;
			align-items: center;
			gap: 1rem;
			z-index: 20;
			animation: fadeSlideDown 0.5s ease both;
		}

		@@keyframes fadeSlideDown {
			from { opacity: 0; transform: translateY(-10px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.wp-back {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			color: var(--wp-text);
			text-decoration: none;
			font-weight: 600;
			font-size: 0.85rem;
			padding: 0.4rem 0.8rem;
			border-radius: 999px;
			border: 1px solid var(--wp-border);
			background: rgba(13, 17, 23, 0.6);
			backdrop-filter: blur(12px);
			transition: all 0.2s ease;
			white-space: nowrap;
			flex-shrink: 0;
		}
		.wp-back:hover {
			background: rgba(229, 9, 20, 0.15);
			border-color: rgba(229, 9, 20, 0.4);
			color: #fff;
		}

		.wp-film-meta { flex: 1; min-width: 0; }

		.wp-film-title {
			font-size: 1.1rem;
			font-weight: 800;
			letter-spacing: -0.02em;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.wp-title-prefix {
			font-size: 0.65rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--wp-muted);
			margin-right: 0.4rem;
		}

		.wp-meta-row {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 0.15rem;
		}

		.wp-chip {
			display: inline-flex;
			align-items: center;
			gap: 0.25rem;
			padding: 0.15rem 0.55rem;
			border-radius: 999px;
			font-size: 0.7rem;
			font-weight: 500;
			border: 1px solid var(--wp-border);
			background: rgba(13, 17, 23, 0.5);
			color: #d1d5db;
		}
		.wp-chip.accent {
			background: rgba(229, 9, 20, 0.12);
			border-color: rgba(229, 9, 20, 0.3);
			color: #ff8787;
			font-weight: 600;
		}
		.wp-chip.live {
			background: rgba(229, 9, 20, 0.25);
			border-color: rgba(229, 9, 20, 0.5);
			color: #ff6b6b;
			animation: livePulse 2s ease-in-out infinite;
		}

		/* Grouped live+viewers cluster */
		.wp-live-cluster {
			display: inline-flex;
			align-items: center;
			gap: 0;
		}
		.wp-live-cluster .wp-chip:first-child {
			border-top-right-radius: 0;
			border-bottom-right-radius: 0;
			border-right: none;
		}
		.wp-live-cluster .wp-chip:last-child {
			border-top-left-radius: 0;
			border-bottom-left-radius: 0;
		}

		/* Festival breadcrumb under title */
		.wp-festival-crumb {
			font-size: 0.65rem;
			color: var(--wp-muted);
			margin-top: 0.1rem;
		}
		.wp-festival-crumb i { color: #ff8787; margin-right: 0.2rem; }

		@@keyframes livePulse {
			0%, 100% { box-shadow: 0 0 0 0 rgba(229, 9, 20, 0); }
			50% { box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.15); }
		}

		.wp-dot {
			width: 3px; height: 3px;
			border-radius: 50%;
			background: var(--wp-muted);
			flex-shrink: 0;
		}

		/* ── Player area ── */
		.wp-player-area {
			display: flex;
			align-items: center;
			justify-content: center;
			background: #000;
			position: relative;
			overflow: hidden;
		}

		.wp-ambient {
			position: absolute;
			width: 80%;
			height: 60%;
			border-radius: 50%;
			background: radial-gradient(ellipse, var(--wp-accent-glow) 0%, transparent 70%);
			filter: blur(80px);
			opacity: 0.3;
			animation: ambientPulse 4s ease-in-out infinite alternate;
			pointer-events: none;
		}

		@@keyframes ambientPulse {
			0% { opacity: 0.2; transform: scale(0.95); }
			100% { opacity: 0.35; transform: scale(1.05); }
		}

		#player {
			width: 100%;
			height: 100%;
			position: relative;
			z-index: 1;
		}

		/* ── Host / Guest badge ── moved to bottom-left to avoid YouTube title bar overlap */
		.wp-host-badge {
			position: absolute;
			bottom: 4.5rem;
			left: 1rem;
			z-index: 10;
			padding: 0.35rem 0.85rem;
			border-radius: 999px;
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			background: var(--wp-accent);
			color: #fff;
			box-shadow: 0 4px 16px var(--wp-accent-glow);
			display: none;
			animation: fadeIn 0.4s ease both;
		}
		.wp-host-badge.visible { display: inline-flex; }

		.wp-guest-badge {
			position: absolute;
			bottom: 4.5rem;
			left: 1rem;
			z-index: 10;
			padding: 0.35rem 0.85rem;
			border-radius: 999px;
			font-size: 0.75rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			background: rgba(255, 255, 255, 0.1);
			border: 1px solid var(--wp-border);
			color: var(--wp-muted);
			display: none;
			animation: fadeIn 0.4s ease both;
		}
		.wp-guest-badge.visible { display: inline-flex; }

		/* ── YouTube chrome mask ── hides 'More videos' / branding at bottom of player */
		.wp-player-area::after {
			content: '';
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			height: 50px;
			background: linear-gradient(to top, #000 60%, transparent);
			z-index: 5;
			pointer-events: none;
		}

		@@keyframes fadeIn {
			from { opacity: 0; transform: scale(0.9); }
			to { opacity: 1; transform: scale(1); }
		}

		/* ── Chat panel ── */
		.wp-chat {
			display: flex;
			flex-direction: column;
			background: var(--wp-chat-bg);
			border-left: 1px solid var(--wp-border);
			overflow: hidden;
		}

		.wp-chat-header {
			padding: 0.85rem 1.25rem;
			border-bottom: 1px solid var(--wp-border);
			display: flex;
			align-items: center;
			gap: 0.5rem;
			flex-shrink: 0;
		}

		.wp-chat-header h2 {
			font-size: 0.95rem;
			font-weight: 700;
			margin: 0;
		}

		.wp-chat-header .wp-online-dot {
			width: 8px; height: 8px;
			border-radius: 50%;
			background: #22c55e;
			box-shadow: 0 0 6px rgba(34, 197, 94, 0.5);
			animation: onlinePulse 2s ease-in-out infinite;
		}

		@@keyframes onlinePulse {
			0%, 100% { transform: scale(1); }
			50% { transform: scale(1.3); }
		}

		.wp-chat-messages {
			flex: 1;
			overflow-y: auto;
			padding: 1rem 1rem 0.5rem;
			display: flex;
			flex-direction: column;
			gap: 0.4rem;
			scroll-behavior: smooth;
		}

		/* Scrollbar styling */
		.wp-chat-messages::-webkit-scrollbar { width: 4px; }
		.wp-chat-messages::-webkit-scrollbar-track { background: transparent; }
		.wp-chat-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

		.wp-msg {
			padding: 0.5rem 0.75rem;
			border-radius: 12px;
			font-size: 0.82rem;
			line-height: 1.45;
			max-width: 95%;
			animation: msgSlideIn 0.25s ease both;
			background: var(--wp-msg-other);
		}

		@@keyframes msgSlideIn {
			from { opacity: 0; transform: translateY(6px); }
			to { opacity: 1; transform: translateY(0); }
		}

		.wp-msg-name {
			font-weight: 700;
			font-size: 0.72rem;
			color: var(--wp-accent);
			margin-bottom: 0.15rem;
		}

		.wp-msg-text {
			color: var(--wp-text);
			word-break: break-word;
			font-family: 'Inter', system-ui, -apple-system, 'Segoe UI Emoji', 'Apple Color Emoji', 'Noto Color Emoji', sans-serif;
		}

		.wp-msg-time {
			font-size: 0.62rem;
			color: var(--wp-muted);
			margin-top: 0.2rem;
		}

		.wp-msg-system {
			text-align: center;
			font-size: 0.72rem;
			color: var(--wp-muted);
			padding: 0.35rem;
			font-style: italic;
		}

		/* ── Chat input ── */
		.wp-chat-input {
			padding: 0.75rem 1rem;
			border-top: 1px solid var(--wp-border);
			display: flex;
			gap: 0.5rem;
			flex-shrink: 0;
			background: var(--wp-surface-2);
		}

		.wp-chat-input input {
			flex: 1;
			background: rgba(255, 255, 255, 0.06);
			border: 1px solid var(--wp-border);
			border-radius: 999px;
			padding: 0.5rem 1rem;
			color: var(--wp-text);
			font-size: 0.85rem;
			font-family: inherit;
			outline: none;
			transition: border-color 0.2s ease;
		}
		.wp-chat-input input::placeholder { color: var(--wp-muted); }
		.wp-chat-input input:focus { border-color: rgba(229, 9, 20, 0.5); }

		.wp-chat-input button {
			background: var(--wp-accent);
			border: none;
			border-radius: 999px;
			padding: 0.5rem 1rem;
			color: #fff;
			font-size: 0.85rem;
			font-weight: 600;
			cursor: pointer;
			transition: all 0.2s ease;
			display: inline-flex;
			align-items: center;
			gap: 0.3rem;
			white-space: nowrap;
		}
		.wp-chat-input button:hover {
			background: #c7080f;
			transform: translateY(-1px);
			box-shadow: 0 4px 12px var(--wp-accent-glow);
		}

		/* ── Connection status ── */
		.wp-status {
			position: absolute;
			bottom: 1rem;
			left: 50%;
			transform: translateX(-50%);
			z-index: 20;
			padding: 0.4rem 1rem;
			border-radius: 999px;
			font-size: 0.75rem;
			font-weight: 600;
			background: rgba(0, 0, 0, 0.7);
			backdrop-filter: blur(8px);
			border: 1px solid var(--wp-border);
			color: var(--wp-muted);
			display: none;
			animation: fadeIn 0.3s ease both;
		}
		.wp-status.visible { display: inline-flex; }
		.wp-status.error { border-color: rgba(239, 68, 68, 0.4); color: #ef4444; }
		.wp-status.connecting { border-color: rgba(234, 179, 8, 0.4); color: #eab308; }
		.wp-status.connected { border-color: rgba(34, 197, 94, 0.4); color: #22c55e; }

		/* ── Lobby overlay ── */
		.wp-lobby {
			position: absolute;
			inset: 0;
			z-index: 15;
			display: flex;
			align-items: center;
			justify-content: center;
			background: rgba(6, 8, 13, 0.92);
			backdrop-filter: blur(20px);
		}

		.wp-lobby-card {
			background: var(--wp-surface);
			border: 1px solid var(--wp-border);
			border-radius: 20px;
			padding: 2.5rem 2rem;
			max-width: 420px;
			width: 90%;
			text-align: center;
			animation: lobbyCardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
			box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 0 40px var(--wp-accent-glow);
		}

		@@keyframes lobbyCardIn {
			from { opacity: 0; transform: translateY(30px) scale(0.95); }
			to   { opacity: 1; transform: translateY(0) scale(1); }
		}

		.wp-lobby-card h2 {
			font-size: 1.4rem;
			font-weight: 800;
			margin-bottom: 0.5rem;
			letter-spacing: -0.02em;
		}

		.wp-lobby-card p {
			color: var(--wp-muted);
			font-size: 0.85rem;
			margin-bottom: 1.25rem;
		}

		.wp-lobby-card input[type="text"] {
			width: 100%;
			padding: 0.75rem 1rem;
			background: rgba(255,255,255,0.06);
			border: 1px solid var(--wp-border);
			border-radius: 12px;
			color: var(--wp-text);
			font-family: 'Inter', monospace;
			font-size: 1.4rem;
			font-weight: 700;
			text-align: center;
			letter-spacing: 0.3em;
			text-transform: uppercase;
			outline: none;
			transition: border-color 0.2s ease;
			margin-bottom: 1rem;
		}
		.wp-lobby-card input[type="text"]::placeholder {
			color: var(--wp-muted);
			letter-spacing: 0.15em;
			font-weight: 500;
		}
		.wp-lobby-card input[type="text"]:focus {
			border-color: rgba(229, 9, 20, 0.5);
			box-shadow: 0 0 0 3px rgba(229, 9, 20, 0.1);
		}

		.wp-lobby-card button.wp-lobby-submit,
		.wp-lobby-card button.wp-start-btn {
			width: 100%;
			padding: 0.75rem 1.5rem;
			background: var(--wp-accent);
			border: none;
			border-radius: 12px;
			color: #fff;
			font-size: 0.95rem;
			font-weight: 700;
			cursor: pointer;
			transition: all 0.25s ease;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.4rem;
		}
		.wp-lobby-card button.wp-lobby-submit:hover,
		.wp-lobby-card button.wp-start-btn:hover {
			background: #c7080f;
			transform: translateY(-2px);
			box-shadow: 0 8px 24px var(--wp-accent-glow);
		}

		.wp-lobby-error {
			margin-top: 0.75rem;
			color: #ef4444;
			font-size: 0.82rem;
			font-weight: 600;
			animation: fadeIn 0.3s ease both;
		}

		/* ── Join code display (host lobby) ── */
		.wp-join-code-display {
			margin: 1.25rem 0;
			padding: 1rem;
			background: rgba(255,255,255,0.04);
			border: 1px solid var(--wp-border);
			border-radius: 14px;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.75rem;
			flex-wrap: wrap;
		}

		.wp-join-code-display span:first-child {
			font-size: 0.8rem;
			color: var(--wp-muted);
			font-weight: 500;
		}

		.wp-code-text {
			font-family: 'Inter', monospace;
			font-size: 1.8rem;
			font-weight: 900;
			letter-spacing: 0.25em;
			color: var(--wp-accent);
			text-shadow: 0 0 20px var(--wp-accent-glow);
		}

		.wp-join-code-display button {
			background: rgba(255,255,255,0.08);
			border: 1px solid var(--wp-border);
			border-radius: 8px;
			padding: 0.4rem 0.6rem;
			color: var(--wp-muted);
			cursor: pointer;
			transition: all 0.2s ease;
			font-size: 1rem;
		}
		.wp-join-code-display button:hover {
			background: rgba(229, 9, 20, 0.15);
			color: #fff;
			border-color: rgba(229, 9, 20, 0.4);
		}

		/* ── Participant list ── */
		.wp-lobby-participants {
			margin: 1.25rem 0;
			text-align: left;
		}

		.wp-lobby-participants h3 {
			font-size: 0.75rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.08em;
			color: var(--wp-muted);
			margin-bottom: 0.5rem;
		}

		.wp-lobby-participants ul {
			list-style: none;
			max-height: 160px;
			overflow-y: auto;
			padding: 0;
			margin: 0;
		}

		.wp-lobby-participants li {
			padding: 0.4rem 0.6rem;
			font-size: 0.82rem;
			color: var(--wp-text);
			border-radius: 8px;
			margin-bottom: 2px;
			background: rgba(255,255,255,0.03);
			display: flex;
			align-items: center;
			gap: 0.4rem;
			animation: msgSlideIn 0.25s ease both;
		}

		.wp-lobby-participants li::before {
			content: '';
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: #22c55e;
			flex-shrink: 0;
		}

		/* ── Role-select buttons ── */
		.wp-role-btn {
			width: 100%;
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 1rem 1.25rem;
			margin-bottom: 0.75rem;
			background: rgba(255,255,255,0.04);
			border: 1px solid var(--wp-border);
			border-radius: 14px;
			color: var(--wp-text);
			text-align: left;
			cursor: pointer;
			transition: all 0.25s ease;
			font-family: inherit;
			font-size: 0.9rem;
		}
		.wp-role-btn:hover {
			background: rgba(229, 9, 20, 0.08);
			border-color: rgba(229, 9, 20, 0.3);
			transform: translateY(-2px);
			box-shadow: 0 6px 20px rgba(0,0,0,0.3);
		}
		.wp-role-btn i {
			font-size: 1.5rem;
			color: var(--wp-accent);
			flex-shrink: 0;
		}
		.wp-role-btn small {
			color: var(--wp-muted);
			font-size: 0.75rem;
		}
		.wp-role-btn strong {
			font-weight: 700;
		}
		.wp-role-error-link {
			color: var(--wp-accent);
			cursor: pointer;
			text-decoration: underline;
		}

		/* ── Reaction bar (inline, does NOT overlay chat) ── */
		.wp-reaction-bar {
			display: flex;
			align-items: center;
			gap: 0.15rem;
			padding: 0.4rem 0.6rem;
			border-top: 1px solid var(--wp-border);
			background: var(--wp-surface);
			flex-shrink: 0;
			justify-content: center;
		}

		.wp-reaction-btn {
			background: rgba(255,255,255,0.04);
			border: 1px solid transparent;
			font-size: 1.15rem;
			padding: 0.3rem 0.5rem;
			cursor: pointer;
			border-radius: 10px;
			transition: all 0.15s ease;
			line-height: 1;
		}
		.wp-reaction-btn:hover {
			background: rgba(255,255,255,0.1);
			border-color: var(--wp-border);
			transform: scale(1.2);
		}
		.wp-reaction-btn:active {
			transform: scale(0.9);
		}

		/* ── Responsive ── */
		@@media (max-width: 900px) {
			.wp-shell {
				grid-template-columns: 1fr;
				grid-template-rows: auto 50vh 1fr;
			}
			.wp-chat {
				border-left: none;
				border-top: 1px solid var(--wp-border);
			}
		}
	</style>
</head>
<body
	data-festival-id="@festivalId"
	data-festival-film-id="@festivalFilmId"
	data-session-id="@sessionId"
	data-youtube-video-id="@youtubeVideoId"
	data-display-name="@displayName"
	data-join-code="@joinCode"
	data-watch-party="true">

	<div class="wp-shell" id="wpShell">
		<!-- ── Top bar ── -->
		<div class="wp-top">
			<a href="/festivals/@festivalId" class="wp-back">
				<i class="bi bi-arrow-left"></i> Back
			</a>
			<div class="wp-film-meta">
				<h1 class="wp-film-title"><span class="wp-title-prefix">Watch Party:</span> @filmName</h1>
				<div class="wp-meta-row">
					<span class="wp-live-cluster">
						<span class="wp-chip live">
							<i class="bi bi-broadcast"></i> LIVE
						</span>
						<span class="wp-chip">
							<i class="bi bi-people-fill"></i> <span id="wpViewerCount">1</span>
						</span>
					</span>
				</div>
				<div class="wp-festival-crumb"><i class="bi bi-film"></i> @festivalName</div>
			</div>
		</div>

		<!-- ── Player area ── -->
		<div class="wp-player-area">
			<div class="wp-ambient"></div>
			<div id="wpHostBadge" class="wp-host-badge"><i class="bi bi-star-fill me-1"></i> HOST</div>
			<div id="wpGuestBadge" class="wp-guest-badge"><i class="bi bi-eye-fill me-1"></i> SYNCED</div>
			<div id="player"></div>

			<!-- ── Lobby overlay (shown while PartyPhase == Lobby) ── -->
			<div id="wpLobby" class="wp-lobby" style="display:none;">
				<!-- Role selection (first screen on connect) -->
				<div id="wpRoleSelect" class="wp-lobby-card" style="display:none;">
					<h2>🎬 Watch Party</h2>
					<p>Choose how you'd like to participate</p>
					<button id="wpBtnHost" type="button" class="wp-role-btn">
						<i class="bi bi-star-fill"></i>
						<div><strong>Host this Party</strong><br><small>Create a room &amp; invite friends</small></div>
					</button>
					<button id="wpBtnJoin" type="button" class="wp-role-btn">
						<i class="bi bi-people-fill"></i>
						<div><strong>Join with a Code</strong><br><small>Enter a code from the host</small></div>
					</button>
					<div id="wpRoleError" class="wp-lobby-error" style="display:none;"></div>
				</div>

				<!-- Join code entry (guests who haven't joined yet) -->
				<div id="wpJoinCodeEntry" class="wp-lobby-card" style="display:none;">
					<h2>🎬 Join Watch Party</h2>
					<p>Enter the 6-character code from the host</p>
					<input id="wpJoinCodeInput" type="text" maxlength="6" placeholder="ABC123" autocomplete="off" />
					<button id="wpJoinCodeSubmit" type="button" class="wp-lobby-submit">Join Party</button>
					<div id="wpJoinCodeError" class="wp-lobby-error" style="display:none;"></div>
				</div>

				<!-- Host lobby view -->
				<div id="wpHostLobby" class="wp-lobby-card" style="display:none;">
					<h2>🎬 Your Watch Party</h2>
					<p>Share this code with your friends to let them join</p>
					<div class="wp-join-code-display">
						<span>Join Code:</span>
						<span id="wpJoinCodeDisplay" class="wp-code-text"></span>
						<button id="wpCopyCode" type="button" title="Copy code"><i class="bi bi-clipboard"></i></button>
					</div>
					<div class="wp-lobby-participants">
						<h3><i class="bi bi-people-fill me-1"></i> Participants</h3>
						<ul id="wpParticipantList"></ul>
					</div>
					<button id="wpStartParty" type="button" class="wp-start-btn">Start Party 🚀</button>
				</div>

				<!-- Guest waiting view -->
				<div id="wpGuestLobby" class="wp-lobby-card" style="display:none;">
					<h2>⏳ Waiting for host to start...</h2>
					<p>Sit tight — the show will begin soon!</p>
					<div class="wp-lobby-participants">
						<h3><i class="bi bi-people-fill me-1"></i> Participants</h3>
						<ul id="wpGuestParticipantList"></ul>
					</div>
				</div>
			</div>
			<div id="wpStatus" class="wp-status connecting visible">
				<i class="bi bi-arrow-repeat me-1"></i> Connecting…
			</div>
		</div>

		<!-- ── Chat panel ── -->
		<div class="wp-chat">
			<div class="wp-chat-header">
				<div class="wp-online-dot"></div>
				<h2>Party Chat</h2>
			</div>
			<div class="wp-chat-messages" id="wpChatMessages">
			</div>
			<div id="wpReactionBar" class="wp-reaction-bar"></div>
			<div class="wp-chat-input">
				<input type="text" id="wpChatInput" placeholder="Say something…" maxlength="500" autocomplete="off" />
				<button id="wpChatSend" type="button"><i class="bi bi-send-fill"></i> Send</button>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js" crossorigin="anonymous"></script>
	<script src="~/js/watch-party.js" asp-append-version="true"></script>
</body>
</html>
