@{
	Layout = "~/Views/Shared/_Layout.cshtml";
	ViewData["Title"] = Localizer["Profile_PageTitle"].Value;
	var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
	var isAdmin = User?.IsInRole("Admin") ?? false;
	var isManager = User?.IsInRole("Organizer") ?? false;
	var firstLetter = User?.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U";
	var userName = User?.Identity?.Name ?? Localizer["Nav_MyProfile"].Value;
	var userEmail = User?.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
}

<section class="container mt-4 d-flex justify-content-center">
	<div class="hub-auth-card" style="max-width: 480px; width: 100%;">
		<div class="text-center mb-4">
			<a class="hub-avatar" href="#" style="width: 100px; height: 100px; font-size: 2.5rem;">
				@firstLetter
			</a>
			<h2 class="mt-3 mb-1">@userName</h2>
			@if (!string.IsNullOrEmpty(userEmail))
			{
				<p class="text-white-50 mb-0">@userEmail</p>
			}
		</div>

		<div class="d-flex flex-column gap-2">
			<a href="/history" class="hub-auth-btn text-center" role="button">@Localizer["Nav_PurchaseHistory"]</a>
			@* Seen (Watched) films — same page as /PersonalList?type=Watched but without other list tabs. *@
			<a href="/watchHistory" class="hub-auth-btn text-center" role="button">@Localizer["Nav_WatchHistory"]</a>
			<hr class="hub-profile-divider">
			<a href="/edit-profile" class="btn btn-outline-light hub-profile-edit-btn w-100 py-2" role="button">@Localizer["EditProfile_PageTitle"]</a>
		</div>
	</div>
</section>