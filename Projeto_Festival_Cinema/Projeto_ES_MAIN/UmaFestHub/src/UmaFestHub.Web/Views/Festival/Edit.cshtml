@model UmaFestHub.Web.ViewModels.FestivalViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Localizer["FestivalEdit_PageTitle"].Value;
}

<div class="hub-auth-wrap">
    <div class="hub-auth-card">
        <h2>@Localizer["FestivalEdit_PageTitle"]</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" style="background: #dc3545; color: white; border: none; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

                <form method="post" asp-route="FestivalEditPost" asp-route-id="@Model.Id" class="hub-auth-form">
                        @Html.AntiForgeryToken()
                        <div>
                                <label>@Localizer["Common_Name"]</label>
                                <input name="Name" value="@Model.Name" type="text" required />
                        </div>
                        <div>
                                <label>@Localizer["Common_Description"]</label>
                                <textarea name="Description" rows="4">@Model.Description</textarea>
                        </div>
                        <div>
                                <label>@Localizer["FestivalEdit_StartDateLabel"]</label>
                                <input name="StartDateUtc" type="datetime-local" value="@(Model.StartDateUtc == DateTime.MinValue ? string.Empty : Model.StartDateUtc.ToString("yyyy-MM-ddTHH:mm"))" required />
                        </div>
                        <div>
                                <label>@Localizer["FestivalEdit_EndDateLabel"]</label>
                                <input name="EndDateUtc" type="datetime-local" value="@(Model.EndDateUtc == DateTime.MinValue ? string.Empty : Model.EndDateUtc.ToString("yyyy-MM-ddTHH:mm"))" required />
                        </div>

                        <div class="hub-early-bird-panel">
                                <h5>@Localizer["FestivalEdit_EarlyBirdHeading"]</h5>
                                <div>
                                        <label>@Localizer["FestivalEdit_DiscountPercentLabel"]</label>
                                        <input name="EarlyBirdDiscountPercent" type="number" step="0.1" min="0" max="100" placeholder="@Localizer["FestivalCreate_DiscountPlaceholder"]" value="@Model.EarlyBirdDiscountPercent" />
                                        <small class="hub-early-bird-hint">@Localizer["FestivalEdit_DiscountPercentHint"]</small>
                                </div>
                                <div class="hub-early-bird-field">
                                        <label>@Localizer["FestivalEdit_DaysBeforeLabel"]</label>
                                        <input name="EarlyBirdDaysBeforeStart" type="number" min="1" placeholder="@Localizer["FestivalCreate_DaysPlaceholder"]" value="@Model.EarlyBirdDaysBeforeStart" />
                                        <small class="hub-early-bird-hint">@Localizer["FestivalEdit_DaysBeforeHint"]</small>
                                </div>
                        </div>

                        <button type="submit" class="hub-auth-btn">@Localizer["FestivalEdit_SaveChanges"]</button>
                </form>
    </div>
</div>
